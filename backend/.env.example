# SiteCare AI configuration
# Copy to .env and adjust as needed. No paid keys are required for core functionality.

# Database (SQLite by default - zero budget)
DATABASE_URL=sqlite:///./sitecare.db

# Crawl limits (protect target websites)
CRAWL_MAX_PAGES=10
CRAWL_MAX_DEPTH=2
REQUEST_TIMEOUT=15
MAX_CONCURRENT_REQUESTS=4

# Discovery (free OpenStreetMap Overpass API)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=60

# Performance
SLOW_RESPONSE_SECONDS=3.0

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Optional AI (rules-based is the default; leave blank to use rules)
LLM_PROVIDER=rules
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional Google APIs (free tier available)
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PAGESPEED_API_KEY=

# Monitoring
MONITOR_INTERVAL_MINUTES=1440
SSL_EXPIRY_WARNING_DAYS=30

# Agency branding (for PDF reports)
AGENCY_NAME=SiteCare AI
AGENCY_TAGLINE=Website Maintenance & Lead Generation
AGENCY_EMAIL=hello@sitecare.ai
AGENCY_PHONE=
AGENCY_WEBSITE=https://sitecare.ai

# Optional SMTP for direct email sending
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
